{
  // 모두 VS Code 기본 기능만 씁니다. 확장을 하나도 안 깔아도 그대로 동작합니다.
  // ($msCompile 문제 표시기도 VS Code 내장이라 컴파일 오류가 클릭 가능합니다.)
  "version": "2.0.0",
  "tasks": [
    {
      // Ctrl+Shift+B 로 실행되는 기본 빌드 작업
      "label": "빌드 (Debug)",
      "type": "shell",
      "command": "${workspaceFolder}\\build.bat",
      "args": ["-Config", "Debug"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$msCompile"],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "detail": "설치된 Visual Studio 를 찾아 구성하고 Debug 로 빌드합니다."
    },
    {
      "label": "빌드 (Release)",
      "type": "shell",
      "command": "${workspaceFolder}\\build.bat",
      "args": ["-Config", "Release"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": ["$msCompile"],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "빌드 + 테스트",
      "type": "shell",
      "command": "${workspaceFolder}\\build.bat",
      "args": ["-Config", "Debug", "-Test"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$msCompile"],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "detail": "빌드한 뒤 ctest 로 logcore_test 를 돌립니다."
    },
    {
      "label": "정리 후 다시 빌드",
      "type": "shell",
      "command": "${workspaceFolder}\\build.bat",
      "args": ["-Config", "Debug", "-Clean"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$msCompile"],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "detail": "빌드 폴더를 지우고 처음부터 구성·빌드합니다. CMakeLists.txt 를 크게 바꾼 뒤에 씁니다."
    },
    {
      "label": "빌드 후 실행",
      "type": "shell",
      "command": "${workspaceFolder}\\build.bat",
      "args": ["-Config", "Debug", "-Run"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$msCompile"],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "detail": "디버거 없이 그냥 실행합니다. 확장이 없을 때 동작을 확인하는 용도."
    }
  ]
}
